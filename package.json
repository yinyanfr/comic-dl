{
  "name": "comic-dl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "extensions/*"
  ],
  "bin": {
    "comic-dl": "dist/index.js"
  },
  "exports": {
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js"
    }
  },
  "files": [
    "dist",
    "docs/extensions.md",
    "docs/migration.md",
    "docs/quickstart.md",
    "docs/src/content/docs/**/*.md",
    "examples/hello-extension.mjs"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:core && npm run build --workspaces --if-present",
    "build:core": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc",
    "check": "npm run format:check && npm run typecheck && npm run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "prepare": "husky",
    "prepack": "npm run build:core",
    "test": "npm run build && node --test",
    "typecheck": "npm run build:core && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.4",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "lint-staged": {
    "*.{js,mjs,ts}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": "prettier --write"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.25.0"
  }
}
